{
  "name": "uns-sentinel-explorer",
  "private": true,
  "version": "1.0.0",
  "description": "UNS Sentinel Explorer is an open-source, web-based dashboard built for Unified Namespace architectures. It features an ISA-95 hierarchical topic tree, multi-broker tab management, and dynamic auto-discovery for legacy topics. Effortlessly inspect real-time JSON payload diffs, plot live telemetry graphs, and publish custom MQTT data streams.",
  "license": "MIT",
  "author": "Nimish Nirmal",
  "homepage": "https://github.com/nimish-nirmal/uns-sentinel-explorer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nimish-nirmal/uns-sentinel-explorer.git"
  },
  "bugs": {
    "url": "https://github.com/nimish-nirmal/uns-sentinel-explorer/issues"
  },
  "keywords": [
    "uns",
    "unified-namespace",
    "mqtt",
    "isa-95",
    "dashboard",
    "telemetry",
    "iot",
    "react",
    "typescript"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently \"npm run dev\" \"node server/index.js\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "server": "node server/index.js",
    "server:dev": "node --watch server/index.js"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "lucide-react": "^0.441.0",
    "mqtt": "^5.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
